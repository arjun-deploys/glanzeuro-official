    },
    {
      "source": "/dutch/b2",
      "destination": "/courses/dutch",
      "permanent": true
    },
    {
      "source": "/dutch",
      "destination": "/courses/dutch",
      "permanent": true
    },
    {
      "source": "/dutch/:level",
      "destination": "/courses/dutch/:level",
      "permanent": true
    }
